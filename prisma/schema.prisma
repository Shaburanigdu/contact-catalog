generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]  // Добавлена эта строка
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["Contact_catalog"]
}

model users {
  id                        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                     String   @unique @db.VarChar(255)
  username                  String?  @unique @db.VarChar(100)
  password_hash             String   @db.VarChar(255)
  email_verified            Boolean? @default(false)
  email_verification_token  String?  @db.VarChar(255)
  password_reset_token      String?  @db.VarChar(255)
  password_reset_expires_at DateTime? @db.Timestamptz
  full_name                 String?  @db.VarChar(255)
  avatar_url                String?  @db.VarChar(500)
  timezone                  String?  @default("UTC") @db.VarChar(50)
  language                  String?  @default("ru") @db.VarChar(10)
  settings                  Json?
  created_at                DateTime? @default(now()) @db.Timestamptz
  updated_at                DateTime? @default(now()) @db.Timestamptz
  deleted_at                DateTime? @db.Timestamptz
  last_login_at             DateTime? @db.Timestamptz

  user_sessions user_sessions[]
  
  @@map("Contact_catalog.users")
}

model user_sessions {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id           String   @db.Uuid
  refresh_token_hash String   @db.VarChar(255)
  user_agent        String?
  ip_address        String?  @db.Inet
  expires_at        DateTime @db.Timestamptz
  created_at        DateTime? @default(now()) @db.Timestamptz
  revoked_at        DateTime? @db.Timestamptz

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("Contact_catalog.user_sessions")
}