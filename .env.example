# Copy to .env and fill in the values.

# PostgreSQL with the pgvector extension
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contact_catalog?schema=Contact_catalog"

# JWT secrets: random strings of 32+ characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
REFRESH_TOKEN_SECRET=""

# Public URL of the app (used in password reset emails)
APP_URL="http://localhost:3000"

# Auth cookies are `secure` in production by default.
# Set to false only when serving over plain HTTP (no TLS).
# COOKIE_SECURE=false

# Local embedding model for AI search (Ollama)
OLLAMA_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
# AI_SEARCH_MIN_SIMILARITY=0.5

# Where uploaded images are stored (defaults to public/uploads)
# UPLOAD_DIR=/data/uploads

# SMTP for password reset emails (e.g. Mailtrap sandbox)
EMAIL_HOST="sandbox.smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Contact Catalog <no-reply@example.com>"
# SMTP_ALLOW_SELF_SIGNED=true
