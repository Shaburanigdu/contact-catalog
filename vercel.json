{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "functions": {
    "api/auth/cleanup.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/auth/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/auth/cleanup",
      "schedule": "0 15 * * *"
    }
  ]
}